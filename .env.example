# Copy this file to .env and edit the values. NEVER publish .env (it is in .gitignore).
# Save .env as UTF-8.

APP_NAME=AutoMarket Korea API
ENVIRONMENT=local
LOG_LEVEL=INFO

# Local development: SQLite (nothing to install).
DATABASE_URL=sqlite:///./automarket.db
# PostgreSQL later (also run: pip install -r requirements-postgres.txt):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Comma-separated list of web origins allowed by CORS (leave empty if not needed).
CORS_ORIGINS=

# Secret for POST /admin/... endpoints. Empty value = admin endpoints are disabled.
ADMIN_API_KEY=

# Source 1: local JSON file (path relative to the backend folder, or absolute).
LOCAL_FEED_PATH=

# Source 2: licensed JSON API. Use only an API whose license allows your use.
LICENSED_FEED_URL=
LICENSED_FEED_API_KEY=
LICENSED_FEED_AUTH_HEADER=Authorization
LICENSED_FEED_AUTH_SCHEME=Bearer

# Network behaviour for remote sources.
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_SECONDS=1.0

# If true: active cars that disappeared from a successful feed are marked "removed".
MARK_MISSING_AS_REMOVED=false